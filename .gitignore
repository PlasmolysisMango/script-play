.tmp-*

# 根目录的一次性提示与计划文件
/1.txt
/全量剧本导入流水线_*.md

# 语音模型（体积大，不进仓库）
web/public/models/
*.onnx
*.onnx.data
*.tokens
*.bin

# 开发期截图（浏览器实测/QA 验收产物，需要文档配图时移入 docs/）
/qa*.png
/shot-*.png
/verify-*.png

# 服务运行日志
server/logs/

# Python 缓存（离线转录/解析脚本）
__pycache__/
*.pyc

# 编辑器/系统
.DS_Store
.idea/
.vscode/
*.log
